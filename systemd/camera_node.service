# TaPS Camera Node service
#
# INSTALL (production unit name is taps-camera-node.service):
#   sudo install -m 644 systemd/camera_node.service \
#       /etc/systemd/system/taps-camera-node.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now taps-camera-node
#
# TIME SYNC:
#   The node latches the GPS 1PPS edge in-process on the GPIO given by
#   --pps-gpio (no /dev/pps0 or chrony refclock required). The rising edge
#   marks the second start; frames are timestamped against the last latched
#   edge and fall back to the system clock until the first edge arrives.
#   Plain NTP (systemd-timesyncd) is enough for wall-clock sanity.
#
# WIRING:
#   Carrier port User_IO1 is GPIO24. The carrier schematic labels it
#   GPIO20 - the schematic is WRONG. Signal is active-LOW (~100 ms low
#   pulse, idle HIGH); the app applies an internal pull-up. Production may
#   feed 1PPS via an RS485 line receiver; same GPIO discipline applies.
#
# CAMERA (final config, 2026-10-18):
#   Arducam UC-852, OmniVision OV9782 global shutter, USB UVC (0c45:6366),
#   /dev/video0. MJPG at 1280x800 runs 30/60/100 fps; YUYV only 10 fps -
#   always use MJPG. 100 fps is the certified boot mode: 100.0 Hz capture
#   (median frame interval 9.8 ms), ~72% of frames carry valid AprilTag
#   poses => ~73 poses/s. The detector, not USB/network/disk, is the
#   system limit: 2 threads + quad-decimation 3 are required for that
#   number; with defaults (1 thread, decimation 2) coverage falls to 32%.
#   Storage at 100 fps is ~1.1-1.3 GB/min - offload regularly. Steady-state
#   SoC ~45 C on the fanless CM5, no throttling observed; drop to -f 60 if
#   it ever exceeds ~70 C (60 fps mode = 100% pose coverage at ~2 cores).
#
# APRILTAG (local target location): keep --apriltag in ExecStart. Poses are
#   recorded to .taps v0x03 and published on NT table "AprilTag".
#
# POWER MODE (offline / thermal, added 2026-10-18):
#   The node BOOTS IN LOW POWER MODE by default: /dev/video0 is never
#   opened and AprilTag processing is idle, so an offline node sits at
#   0% CPU / ~28 C instead of ~75% / ~45 C. The web UI, SSE, PPS time
#   sync and NetworkTables stay fully reachable; recording start and the
#   calibration wizard are refused (HTTP 409) until capture is enabled.
#   Toggle: "Enter Normal Mode" / "Low Power Mode" button at
#   http://<camera>:8080, or POST {"enable":false} to /lowpower (GET
#   /lowpower reports state; enabling low power stops an active
#   recording first and flushes the .taps cleanly). To restore the old
#   always-capturing behavior, append --start-capturing to ExecStart.
#
# CAMERA CALIBRATION: run the guided wizard at http://<camera>:8080/calibrate.
#   Intrinsics land in <output>/calibration.json, are loaded at startup
#   automatically, and drive pose estimation + .taps headers. Recalibrate
#   whenever the capture resolution changes. Current OV9782 800p set
#   (fx 926.4 fy 925.1 cx 692.7 cy 387.5, RMS 1.68 px) is archived in
#   config/calibrations/ in this repo.
#
# GPIO EXCLUSIVITY: do NOT run pps-watch.service alongside this unit - GPIO
#   line requests are exclusive. Stop this unit before using the watcher.
#
# MAINTENANCE: stop with systemctl stop (SIGTERM) ONLY; TimeoutStopSec=30
#   lets an open .taps flush. Never SIGKILL mid-stream (wedges the UVC
#   session until physical USB replug or reboot) and allow >= 4 s between
#   stop and relaunch.

[Unit]
Description=TaPS CameraNode daemon (OV9782 UC-852, 100fps MJPG 800p, apriltag 2thr dec3)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dan
WorkingDirectory=/home/dan/taps/camera_node
# Keep OpenCV V4L2 debug spam out of the journal and /tmp
Environment=OPENCV_VIDEOIO_DEBUG=0
# Final config, reboot-verified on CameraNode1 (CM5, Debian 13) 2026-10-18
ExecStart=/home/dan/taps/camera_node/build/TaPS_CameraNode \
    -c 0 -w 1280 -h 800 -f 100 -F MJPG \
    --apriltag --apriltag-threads=2 --apriltag-quad-decimation=3 \
    --camera-alias CameraNode1 -o output \
    --pps-gpio 24
# NetworkTables triggers (enable in production; replace 10.0.1.X):
#   --nt-server 10.0.1.X --nt-match-start RoboRIO/matchStart \
#   --nt-match-end RoboRIO/matchEnd --nt-local CameraNode1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
